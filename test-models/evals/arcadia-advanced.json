{
  "description": "Harder Arcadia tasks: multi-element architectures, chains, interfaces, deployment, cross-layer traceability and a subsystem large enough to need several reviewed proposals. Scored only by native checks. Run on a disposable copy with restore=true.",
  "restore": true,
  "tasks": [
    {
      "id": "adv-bms-functional-architecture",
      "prompt": "In the system analysis, build the functional architecture of a battery management system. Create the system functions 'Measure Cell Voltages', 'Measure Cell Temperatures', 'Estimate State of Charge', 'Detect Fault' and 'Command Contactor'. Connect them with functional exchanges: 'Cell Voltages' from Measure Cell Voltages to Estimate State of Charge, 'Cell Temperatures' from Measure Cell Temperatures to Detect Fault, 'Voltage Limits' from Measure Cell Voltages to Detect Fault, and 'Fault Status' from Detect Fault to Command Contactor.",
      "checks": [
        {
          "kind": "element_exists",
          "type": "SystemFunction",
          "name": "Measure Cell Voltages",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "SystemFunction",
          "name": "Measure Cell Temperatures",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "SystemFunction",
          "name": "Estimate State of Charge",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "SystemFunction",
          "name": "Detect Fault",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "SystemFunction",
          "name": "Command Contactor",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "FunctionalExchange",
          "name": "Cell Voltages",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "FunctionalExchange",
          "name": "Cell Temperatures",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "FunctionalExchange",
          "name": "Voltage Limits",
          "layer": "SA"
        },
        {
          "kind": "element_exists",
          "type": "FunctionalExchange",
          "name": "Fault Status",
          "layer": "SA"
        }
      ]
    },
    {
      "id": "adv-functional-chain",
      "prompt": "Create the system functions 'Read Pedal', 'Compute Torque' and 'Drive Motor', connected in that order by the functional exchanges 'Pedal Signal' and 'Torque Command'. Then create a functional chain 'Torque Path' that involves the three functions and both exchanges.",
      "checks": [
        {
          "kind": "element_exists",
          "type": "FunctionalChain",
          "name": "Torque Path",
          "layer": "SA"
        },
        {
          "kind": "native_structure",
          "check": {
            "kind": "relation_exists",
            "type": "FunctionalChainInvolvementFunction",
            "predicates": {
              "involved": {
                "type": "SystemFunction",
                "name": "Read Pedal",
                "layer": "SA"
              }
            },
            "owner": {
              "type": "FunctionalChain",
              "name": "Torque Path",
              "layer": "SA"
            }
          }
        },
        {
          "kind": "native_structure",
          "check": {
            "kind": "relation_exists",
            "type": "FunctionalChainInvolvementFunction",
            "predicates": {
              "involved": {
                "type": "SystemFunction",
                "name": "Drive Motor",
                "layer": "SA"
              }
            },
            "owner": {
              "type": "FunctionalChain",
              "name": "Torque Path",
              "layer": "SA"
            }
          }
        }
      ]
    },
    {
      "id": "adv-exchange-allocated-to-component-exchange",
      "prompt": "In the logical architecture, create the components 'Pedal Box' and 'Vehicle Controller'. Allocate a new logical function 'Sense Pedal' to Pedal Box and a new logical function 'Arbitrate Torque' to Vehicle Controller. Connect the functions with a functional exchange 'Pedal Position', connect the components with a component exchange 'Pedal Link', and allocate the functional exchange to the component exchange.",
      "checks": [
        {
          "kind": "element_exists",
          "type": "ComponentExchange",
          "name": "Pedal Link",
          "layer": "LA"
        },
        {
          "kind": "native_structure",
          "check": {
            "kind": "relation_exists",
            "type": "ComponentExchangeFunctionalExchangeAllocation",
            "predicates": {
              "sourceElement": {
                "type": "ComponentExchange",
                "name": "Pedal Link",
                "layer": "LA"
              },
              "targetElement": {
                "type": "FunctionalExchange",
                "name": "Pedal Position",
                "layer": "LA"
              }
            }
          }
        },
        {
          "kind": "native_structure",
          "check": {
            "kind": "relation_exists",
            "type": "ComponentFunctionalAllocation",
            "predicates": {
              "sourceElement": {
                "type": "LogicalComponent",
                "name": "Vehicle Controller",
                "layer": "LA"
              },
              "targetElement": {
                "type": "LogicalFunction",
                "name": "Arbitrate Torque",
                "layer": "LA"
              }
            }
          }
        }
      ]
    },
    {
      "id": "adv-interface-exchange-item",
      "prompt": "In the logical architecture, create an exchange item 'Torque Setpoint' and an interface 'Torque Command Interface' that carries it.",
