            "predicates": {
              "allocatedItem": {
                "type": "ExchangeItem",
                "name": "Torque Setpoint",
                "layer": "LA"
              }
            },
            "owner": {
              "type": "Interface",
              "name": "Torque Command Interface",
              "layer": "LA"
            }
          }
        }
      ]
    },
    {
      "id": "adv-behavior-deployed-on-node",
      "prompt": "In the physical architecture, create a node component 'Inverter Board' and a behavior component 'Motor Control Software', and deploy the software on the board.",
      "checks": [
        {
          "kind": "attribute_equals",
          "type": "PhysicalComponent",
          "name": "Inverter Board",
          "layer": "PA",
          "attribute": "nature",
          "expected": "NODE"
        },
        {
          "kind": "attribute_equals",
          "type": "PhysicalComponent",
          "name": "Motor Control Software",
          "layer": "PA",
          "attribute": "nature",
          "expected": "BEHAVIOR"
        },
        {
          "kind": "native_structure",
          "check": {
            "kind": "relation_exists",
            "type": "PartDeploymentLink",
            "predicates": {
              "deployedElement": {
                "type": "Part",
                "name": "Motor Control Software",
                "layer": "PA"
              },
              "location": {
                "type": "Part",
                "name": "Inverter Board",
                "layer": "PA"
              }
            }
          }
        }
      ]
    },
    {
