<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.views">
        <category
            id="com.sidkolapalli.capella.ai"
            name="Capella AI Assistant"/>
        <view
            allowMultiple="false"
            category="com.sidkolapalli.capella.ai"
            class="com.sidkolapalli.capella.ai.ChatView"
            id="com.sidkolapalli.capella.ai.chatview"
            name="Capella AI Assistant"/>
        <view
            allowMultiple="false"
            category="com.sidkolapalli.capella.ai"
            class="com.sidkolapalli.capella.ai.views.DiagramsView"
            id="com.sidkolapalli.capella.ai.diagrams"
            name="AI Diagrams"/>
        <view
            allowMultiple="false"
            category="com.sidkolapalli.capella.ai"
            class="com.sidkolapalli.capella.ai.views.LogInspectorView"
            id="com.sidkolapalli.capella.ai.logs"
            name="AI Log Inspector"/>
        <view
            allowMultiple="false"
            category="com.sidkolapalli.capella.ai"
            class="com.sidkolapalli.capella.ai.dev.DevServerView"
            id="com.sidkolapalli.capella.ai.dev.DevServerView"
            name="AI Dev Server"/>
    </extension>

    <extension point="org.eclipse.ui.perspectiveExtensions">
        <perspectiveExtension targetID="capella.sirius.perspective">
            <view
                closeable="true"
                id="com.sidkolapalli.capella.ai.chatview"
                minimized="false"
                moveable="true"
                relationship="right"
                relative="org.eclipse.ui.editorss"
                ratio="0.72"
                visible="true"/>
            <view
                closeable="true"
                id="com.sidkolapalli.capella.ai.diagrams"
                minimized="false"
                moveable="true"
                relationship="right"
                relative="com.sidkolapalli.capella.ai.chatview"
                visible="false"/>
            <view
                closeable="true"
                id="com.sidkolapalli.capella.ai.logs"
                minimized="false"
                moveable="true"
                relationship="bottom"
                relative="com.sidkolapalli.capella.ai.chatview"
                visible="false"/>
        </perspectiveExtension>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page
            id="com.sidkolapalli.capella.ai.preferences.llm"
            name="LLM"
            class="com.sidkolapalli.capella.ai.preferences.LLMPreferencePage"
            category="org.polarsys.capella.core.platform.sirius.ui.actions.Capella.page"/>
        <page
            id="com.sidkolapalli.capella.ai.preferences.advanced"
            name="AI Advanced Settings"
            class="com.sidkolapalli.capella.ai.preferences.AdvancedPreferencePage"
            category="org.polarsys.capella.core.platform.sirius.ui.actions.Capella.page"/>
    </extension>

    <extension point="org.eclipse.ui.startup">
        <startup class="com.sidkolapalli.capella.ai.dev.DevServerStartup"/>
    </extension>
</plugin>
