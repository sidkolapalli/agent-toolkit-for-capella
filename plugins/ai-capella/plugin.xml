<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
    <extension point="org.eclipse.ui.views">
        <category
            id="org.polarsys.capella.ai"
            name="Capella AI Assistant"/>
        <view
            allowMultiple="false"
            category="org.polarsys.capella.ai"
            class="org.polarsys.capella.ai.ChatView"
            id="org.polarsys.capella.ai.chatview"
            name="Capella AI Assistant"/>
        <view
            allowMultiple="false"
            category="org.polarsys.capella.ai"
            class="org.polarsys.capella.ai.views.DiagramsView"
            id="org.polarsys.capella.ai.diagrams"
            name="AI Diagrams"/>
    </extension>

    <extension point="org.eclipse.ui.perspectiveExtensions">
        <perspectiveExtension targetID="capella.perspective">
            <view
                closeable="true"
                id="org.polarsys.capella.ai.chatview"
                minimized="false"
                moveable="true"
                relationship="right"
                relative="org.eclipse.ui.editors"
                visible="true"/>
            <view
                closeable="true"
                id="org.polarsys.capella.ai.diagrams"
                minimized="false"
                moveable="true"
                relationship="right"
                relative="org.polarsys.capella.ai.chatview"
                visible="true"/>
        </perspectiveExtension>
    </extension>

    <extension point="org.eclipse.ui.preferencePages">
        <page
            id="org.polarsys.capella.ai.preferences.llm"
            name="LLM"
            class="org.polarsys.capella.ai.preferences.LLMPreferencePage"
            category="org.polarsys.capella.preferences"/>
    </extension>
</plugin>
